{
  "name": "@rixl/sdk",
  "version": "0.37.1",
  "description": "Official TypeScript/JavaScript SDK for the Rixl platform — typed API client, authentication, and reactive state.",
  "keywords": [
    "media",
    "rixl",
    "sdk",
    "video",
    "web"
  ],
  "homepage": "https://github.com/rixlhq/rixl-js",
  "bugs": {
    "url": "https://github.com/rixlhq/rixl-js/issues"
  },
  "license": "MIT",
  "author": "Rixl Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rixlhq/rixl-js.git"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vp pack --watch",
    "build": "vp pack",
    "generate": "RIXL_GENERATE=true vp pack",
    "check": "vp check",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "test": "vp test",
    "test:ui": "vp test --ui",
    "test:coverage": "vp test --coverage",
    "typecheck": "tsc --noEmit",
    "examples:check": "tsc --noEmit -p examples/tsconfig.json",
    "prepare": "[ -n \"$CI\" ] || lefthook install --reset-hooks-path",
    "ci:release": "vp check && vp pack && npm publish"
  },
  "dependencies": {
    "jose": "^6.2.13",
    "nanostores": "^1.5.5",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@hey-api/vite-plugin": "0.3.2",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "typescript": "6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
