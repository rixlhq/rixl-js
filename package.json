{
  "name": "@rixl/sdk",
  "version": "0.43.0",
  "description": "Official TypeScript/JavaScript SDK for the Rixl platform — typed API client, authentication, and reactive state.",
  "keywords": [
    "media",
    "rixl",
    "sdk",
    "video",
    "web"
  ],
  "homepage": "https://github.com/rixlhq/rixl-js",
  "bugs": {
    "url": "https://github.com/rixlhq/rixl-js/issues"
  },
  "license": "MIT",
  "author": "Rixl Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rixlhq/rixl-js.git"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vp pack --watch",
    "build": "vp pack",
    "generate": "RIXL_GENERATE=true vp pack",
    "check": "vp check",
    "lint": "vp lint",
    "lint:suppressions": "! grep -rnE '(eslint|oxlint)-disable' src examples vite.config.ts --include='*.ts' --exclude-dir=generated | grep -v ' -- '",
    "knip": "knip --no-progress",
    "fmt": "vp fmt",
    "test": "vp test",
    "test:ui": "vp test --ui",
    "test:coverage": "vp test --coverage",
    "budget": "size-limit",
    "publint": "publint --strict",
    "ci": "vp check && vp run lint:suppressions && vp run knip && vp run examples:check && vp test --coverage --run && vp pack && vp run budget && vp run publint",
    "typecheck": "tsc --noEmit",
    "examples:check": "tsc --noEmit -p examples/tsconfig.json",
    "prepublishOnly": "vp run build",
    "prepare": "[ -n \"$CI\" ] || lefthook install --reset-hooks-path",
    "ci:release": "vp run ci && npm publish"
  },
  "dependencies": {
    "jose": "^6.2.13",
    "nanostores": "^1.5.5",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@hey-api/vite-plugin": "0.3.2",
    "@size-limit/file": "^14.3.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/ui": "5.1.0",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.4",
    "knip": "^6.45.1",
    "lefthook": "^2.2.2",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "typescript": "^7.0.2",
    "typescript-compat": "npm:typescript@6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.5.0"
  },
  "overrides": {
    "@hey-api/openapi-ts": {
      "typescript": "6.0.3"
    },
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": ">=26.12.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
