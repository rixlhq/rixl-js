{
  "name": "@rixl/sdk",
  "version": "0.23.1",
  "description": "Official TypeScript/JavaScript SDK for the Rixl platform — typed API client, authentication, and reactive state.",
  "keywords": [
    "media",
    "rixl",
    "sdk",
    "video",
    "web"
  ],
  "homepage": "https://github.com/rixlhq/rixl-js",
  "bugs": {
    "url": "https://github.com/rixlhq/rixl-js/issues"
  },
  "license": "MIT",
  "author": "Rixl Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rixlhq/rixl-js.git"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vp pack --watch",
    "build": "vp pack",
    "generate": "RIXL_GENERATE=true vp pack",
    "check": "vp check",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "test": "vp test",
    "test:ui": "vp test --ui",
    "test:coverage": "vp test --coverage",
    "typecheck": "tsc --noEmit",
    "examples:check": "tsc --noEmit -p examples/tsconfig.json",
    "prepare": "vp config",
    "ci:release": "vp check && vp pack && npm publish"
  },
  "dependencies": {
    "jose": "^6.2.3",
    "nanostores": "^1.5.1",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@hey-api/vite-plugin": "0.3.2",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "jsdom": "^30.0.0",
    "typescript": "6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plus": "^0.3.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.0"
}
